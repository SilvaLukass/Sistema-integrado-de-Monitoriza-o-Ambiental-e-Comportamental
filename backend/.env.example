TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Camera (RPi Flask service)
CAMERA_SERVICE_URL=http://192.168.1.50:5001
CAMERA_CAPTURE_TIMEOUT_SECONDS=15

# Metrics (RPi Flask service)
METRICS_SERVICE_URL=http://192.168.1.50:5002
METRICS_FETCH_TIMEOUT_SECONDS=5

# RabbitMQ (use eldercare user for LAN access from the RPi)
RABBITMQ_URL=amqp://eldercare:eldercare_dev@localhost:5672/
RABBITMQ_EXCHANGE=eldercare.sensors
RABBITMQ_QUEUE=sensor_readings
RABBITMQ_ROUTING_KEY=sensors.simulator
CONSUMER_ENABLED=true
SIMULATOR_ENABLED=true
