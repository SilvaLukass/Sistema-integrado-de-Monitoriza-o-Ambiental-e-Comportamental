CORS_ORIGINS=http://localhost:5173

# Telegram bot integration. Leave empty to disable notifications locally.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# RabbitMQ broker reachable by both backend and Raspberry Pi.
RABBITMQ_URL=amqp://eldercare:eldercare_dev@localhost:5672/
RABBITMQ_EXCHANGE=eldercare.sensors
RABBITMQ_QUEUE=sensor_readings
RABBITMQ_ROUTING_KEY=sensors.rpi

# HTTP camera service running on the Raspberry Pi.
CAMERA_SERVICE_URL=http://RPI_IP:5001
CAMERA_CAPTURE_TIMEOUT_SECONDS=15

# HTTP metrics service running on the Raspberry Pi.
METRICS_SERVICE_URL=http://RPI_IP:5002
METRICS_FETCH_TIMEOUT_SECONDS=5
